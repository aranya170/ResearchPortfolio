# Server Configuration
PORT=5000
NODE_ENV=development

# JWT Secret for Admin Auth (required in production, 32+ random chars)
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1d

# Initial admin account (only used when admin_users is empty, or by scripts/updateAdmin.js)
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Extra allowed CORS origins, comma-separated (the Firebase domains are built in)
FRONTEND_URL=

# PostgreSQL Connection (Use either DATABASE_URL or individual parameters)
# Option 1: Full Connection String (Neon, Supabase, Railway, Render, Local)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/portfolio_db

# Option 2: Individual Connection Parameters
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=portfolio
DB_SSL=false
# Set to true only for self-signed dev databases; skips TLS certificate verification
DB_SSL_INSECURE=false
